<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_label"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"
            android:importantForAccessibility="yes" />

        <!-- Keep-alive-after-lock toggle -->
        <CheckBox
            android:id="@+id/chkKeepAlive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keep_alive_label"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/desc_keep_alive_checkbox" />

        <!-- 1. Consistent Mode -->
        <Button
            android:id="@+id/btnConsistent"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="@string/mode_consistent_button"
            android:textSize="18sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/desc_consistent_button" />

        <!-- 2. Pulsing Mode -->
        <Button
            android:id="@+id/btnPulsing"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="@string/mode_pulsing_button"
            android:textSize="18sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/desc_pulsing_button" />

        <!-- 3. Inconsistent Mode (formerly "Unpredictable") -->
        <Button
            android:id="@+id/btnInconsistent"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="@string/mode_inconsistent_button"
            android:textSize="18sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/desc_inconsistent_button" />

        <!-- 4. Vacuum Mode -->
        <Button
            android:id="@+id/btnVacuum"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="@string/mode_vacuum_button"
            android:textSize="18sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/desc_vacuum_button" />

        <!-- 5. Truly Unpredictable Mode -->
        <Button
            android:id="@+id/btnTrulyRandom"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="@string/mode_truly_random_button"
            android:textSize="18sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/desc_truly_random_button" />

        <!-- 6. Hammer Mode -->
        <Button
            android:id="@+id/btnHammer"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="@string/mode_hammer_button"
            android:textSize="18sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/desc_hammer_button" />

        <!-- 7. Short-Long Alternation (new) -->
        <Button
            android:id="@+id/btnShortLong"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="@string/mode_short_long_button"
            android:textSize="18sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/desc_short_long_button" />

        <!-- 8. Gradual Strengthening (new) -->
        <Button
            android:id="@+id/btnRampUp"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="@string/mode_ramp_up_button"
            android:textSize="18sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/desc_ramp_up_button" />

        <!-- 9. Gradual Weakening (new) -->
        <Button
            android:id="@+id/btnRampDown"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="@string/mode_ramp_down_button"
            android:textSize="18sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/desc_ramp_down_button" />

        <!-- 10. Wave-like Intensity (new) -->
        <Button
            android:id="@+id/btnWave"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="@string/mode_wave_button"
            android:textSize="18sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="32dp"
            android:contentDescription="@string/desc_wave_button" />

        <!-- Stop Button -->
        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="@string/stop_button"
            android:textSize="18sp"
            android:backgroundTint="#B00020"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/desc_stop_button" />

        <!-- Settings Button (always the final button) -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="@string/settings_button"
            android:textSize="18sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:contentDescription="@string/desc_settings_button" />

    </LinearLayout>
</ScrollView>
